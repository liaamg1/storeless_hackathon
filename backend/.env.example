DATABASE_URL=postgresql://my:mypass@localhost:5433/restore
# Relative paths are resolved from backend/, regardless of the launch directory.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=25000000

MAX_VIDEO_UPLOAD_BYTES=3000000000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_TIMEOUT_SECONDS=3600
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Bound audio/feature memory for long recordings; valid range is 1–120 seconds.
WHISPER_CHUNK_SECONDS=60
# Keep inference from monopolizing the host while the API and database run.
WHISPER_CPU_THREADS=2
# Empty or auto enables language detection; use e.g. en or sv to set it explicitly.
WHISPER_LANGUAGE=auto
WHISPER_DOWNLOAD_ROOT=.cache/whisper
# The API supervises a local worker by default. Disable when managing one separately.
AUTO_START_TRANSCRIPTION_WORKER=true

# Slide comparison: heuristic 64-bit perceptual-hash similarity percentage.
SLIDE_SIMILARITY_THRESHOLD=90
PRESENTATION_MAX_SLIDES=500
PRESENTATION_RENDER_TIMEOUT_SECONDS=120
LIBREOFFICE_BINARY=libreoffice

VISUAL_SAMPLE_INTERVAL_SECONDS=5
VISUAL_HASH_DISTANCE=6
VISUAL_MAX_FRAMES=300

# Independent background processes. One transcription at a time limits model RAM.
TRANSCRIPTION_WORKERS=1
DOCUMENT_WORKERS=2
VISUAL_WORKERS=1
