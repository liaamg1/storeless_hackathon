DATABASE_URL=postgresql://my:mypass@localhost:5433/restore
# Relative paths are resolved from backend/, regardless of the launch directory.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=25000000

MAX_VIDEO_UPLOAD_BYTES=3000000000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_TIMEOUT_SECONDS=3600
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Keep inference fast while leaving CPU headroom for the API and database.
WHISPER_CPU_THREADS=4
# Pinned by default so Whisper cannot mis-detect a random language. Set auto to detect.
WHISPER_LANGUAGE=en
WHISPER_DOWNLOAD_ROOT=.cache/whisper
# Local speaker labelling (no extra models). Falls back to "Speaker" on any problem.
SPEAKER_IDENTIFICATION=true
SPEAKER_MAX_SPEAKERS=6
# The API supervises a local worker by default. Disable when managing one separately.
AUTO_START_TRANSCRIPTION_WORKER=true
